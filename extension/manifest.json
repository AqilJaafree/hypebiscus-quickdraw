{
  "manifest_version": 3,
  "name": "Quickdraw",
  "version": "0.1.0",
  "description": "Instant Solana token analysis — highlight any address to see the organic score.",
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://lite-api.jup.ag/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon48.png"
  }
}

# Copy to .env and fill in values when you have a deployed Cloudflare Worker.
# Without these, the app still runs but AI narration shows a stub message.

# URL of your deployed Cloudflare Worker
WORKER_URL=https://quickdraw-worker.YOUR_SUBDOMAIN.workers.dev

# Shared secret for HMAC request signing (must match the Worker's APP_SECRET)
APP_SECRET=change_me_to_a_random_32_char_string

# Optional: control log verbosity
RUST_LOG=quickdraw=info
